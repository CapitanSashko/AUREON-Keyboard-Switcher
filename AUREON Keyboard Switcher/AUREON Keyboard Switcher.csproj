<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- === ОСНОВНЫЕ НАСТРОЙКИ === -->
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>AUREON_Keyboard_Switcher</RootNamespace>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>

		<!-- === ПУБЛИКАЦИЯ И СБОРКА === -->
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Resources\AUREON.ico</ApplicationIcon>
		<Deterministic>true</Deterministic>

		<!-- Важно для публикации без ошибок и работы с архитектурами -->
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>AnyCPU</PlatformTarget>

		<!-- Список поддерживаемых архитектур для восстановления пакетов (NuGet Restore) -->
		<RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>

		<!-- Отключаем проблемные функции при публикации (вызывали ошибки в .NET 10) -->
		<PublishSingleFile>false</PublishSingleFile>
		<PublishReadyToRun>false</PublishReadyToRun>

		<!-- === АВТОРСТВО И МЕТАДАННЫЕ === -->
		<Authors>Oleksandr Echkenko</Authors>
		<Company>CapitanSashko Company</Company>
		<Product>AUREON Keyboard Switcher</Product>
		<Description>Розумний перемикач розкладки клавіатури з автовиправленням</Description>
		<Copyright>© 2026 CapitanSashko. Всі права захищені.</Copyright>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
	</PropertyGroup>

	<!-- === РЕСУРСЫ (ИКОНКИ) === -->
	<ItemGroup>
		<Content Include="Resources\AUREON.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\AUREON_off.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- === СЛОВАРИ === -->
	<ItemGroup>
		<None Update="Dictionaries\de.txt">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Dictionaries\en.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Dictionaries\ru.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Dictionaries\uk.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- === ПАПКИ === -->
	<ItemGroup>
		<Folder Include="Languages\" />
	</ItemGroup>

</Project>